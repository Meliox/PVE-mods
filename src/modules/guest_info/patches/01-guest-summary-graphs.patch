+Ext.define('PVE.mod.GuestSummaryChart', {
+    extend: 'Proxmox.widget.RRDChart',
+    alias: 'widget.pveModGuestSummaryChart',
+
+    statics: {
+        pressureField: function (field, title) {
+            return {
+                yField: field, title, fill: false,
+                tooltip: {
+                    trackMouse: true,
+                    renderer: function (tooltip, record) {
+                        const value = record.get(field);
+                        tooltip.setHtml(Ext.isNumber(value)
+                            ? `${title}: ${Ext.util.Format.number(value, '0.##')}%<br>${new Date(record.get('time'))}`
+                            : gettext('No Data'));
+                    },
+                },
+            };
+        },
+    },
+
+    constructor: function (config) {
+        this.callParent([config]);
+        const me = this;
+        const legend = me.header.items.findBy(item => item.isDomLegend);
+        me.header.remove(legend, false);
+        me.addDocked({
+            xtype: 'toolbar',
+            dock: 'top',
+            overflowHandler: 'scroller',
+            items: [legend],
+        });
+        legend.flex = 1;
+        const alignLegend = function () {
+            const container = legend.el.down('.x-legend-container');
+            if (!container) {
+                return;
+            }
+            legend.el.down('.x-legend-inner').setStyle('width', '100%');
+            container.setStyle({ display: 'flex', width: '100%', 'text-align': 'left' });
+            let firstPressure = true;
+            const items = legend.el.query('.x-legend-item');
+            const style = items.length ? getComputedStyle(items[0]) : null;
+            items.forEach((item, index) => {
+                const record = legend.getStore().getAt(Number(item.getAttribute('data-recordindex')));
+                const series = me.getSeries().map[record.get('series')];
+                const pressure = String(series.getYField()).startsWith('pressure');
+                const startsPressure = pressure && firstPressure;
+                item.style.marginLeft = startsPressure ? 'auto' : '';
+                item.style.borderLeft = startsPressure ? style.borderLeft : '';
+                item.style.borderTopLeftRadius = startsPressure ? style.borderTopLeftRadius : '';
+                item.style.borderBottomLeftRadius = startsPressure ? style.borderBottomLeftRadius : '';
+                if (startsPressure && index > 0) {
+                    items[index - 1].style.borderTopRightRadius = style.borderTopLeftRadius;
+                    items[index - 1].style.borderBottomRightRadius = style.borderBottomLeftRadius;
+                }
+                if (pressure) {
+                    firstPressure = false;
+                }
+            });
+        };
+        me.mon(legend, 'refresh', alignLegend);
+        me.mon(legend, 'itemupdate', alignLegend);
+        me.mon(legend, 'afterrender', alignLegend);
+        if (config.unit === 'bytes') {
+            const right = Array.from(me.getAxes()).find(axis => axis.getPosition() === 'right');
+            right.setSegmenter({ type: 'numeric' });
+        }
+    },
+});
