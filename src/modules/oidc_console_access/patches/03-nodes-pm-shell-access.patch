+# pve-mods oidc_console_access: lets members of shell_groups use the root shell without a login prompt
+sub pvemods_shell_allowed {
+    my ($userid) = @_;
+
+    my $conf = '/etc/pve-mods/conf.d/oidc_console_access.conf';
+    return 0 if !-r $conf;
+
+    my $config = file_get_contents($conf);
+    my ($enabled) = $config =~ /^\s*shell\s*=\s*(1)\s*$/m;
+    return 0 if !defined($enabled);
+
+    my ($groups) = $config =~ /^\s*shell_groups\s*=\s*(.*?)\s*$/m;
+    return 0 if !defined($groups) || $groups eq '';
+
+    my $usercfg = cfs_read_file('user.cfg');
+    return 0 if !PVE::AccessControl::check_user_enabled($usercfg, $userid, 1);
+
+    my $user_groups = $usercfg->{users}->{$userid}->{groups} // {};
+    return scalar(grep { $user_groups->{$_} } split(/[\s,]+/, $groups)) ? 1 : 0;
+}
