+__PACKAGE__->register_method({
+    name => 'gpurrddata',
+    path => 'gpurrddata',
+    method => 'GET',
+    # Not protected: it is served by pveproxy, which reads the www-data owned
+    # GPU RRD files directly. Routing it through PVE::RRD would go through the
+    # root-only rrdcached socket and fail, and a protected call would be
+    # forwarded to pvedaemon, which keeps running the unpatched Nodes.pm until
+    # it is restarted.
+    proxyto => 'node',
+    permissions => {
+        check => ['perm', '/nodes/{node}', ['Sys.Audit']],
+    },
+    description => "Read GPU RRD statistics",
+    parameters => {
+        additionalProperties => 0,
+        properties => {
+            node => get_standard_option('pve-node'),
+            card => {
+                description => "The GPU history identifier, derived from its PCI address (e.g. pci000000020).",
+                type => 'string',
+                pattern => '[a-zA-Z0-9]+',
+            },
+            timeframe => {
+                description => "Specify the time frame you are interested in.",
+                type => 'string',
+                enum => ['hour', 'day', 'week', 'month', 'year', 'decade'],
+            },
+            cf => {
+                description => "The RRD consolidation function",
+                type => 'string',
+                enum => ['AVERAGE', 'MAX'],
+                optional => 1,
+            },
+        },
+    },
+    returns => {
+        type => "array",
+        items => {
+            type => "object",
+            properties => {},
+        },
+    },
+    code => sub {
+        my ($param) = @_;
+        require PVE::PVEMods::Store;
+        return PVE::PVEMods::Store::read_gpu_rrd_data(
+            $param->{card}, $param->{timeframe}, $param->{cf},
+        );
+    },
+});
 
