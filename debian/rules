#!/usr/bin/make -f
%:
	dh $@

override_dh_install:
	# ── Static section ─────────────────────────────────────────────────────
	# Generic, mod-independent files that never change when mods are added.
	# Everything mod-specific (module files, patches, per-mod configs) is
	# generated and appended below by build/gen-rules.sh at build time and is
	# NOT committed to the repository.
	#
	# Patch helpers (generic, manifest-driven)
	install -Dm755 src/scripts/apply-patches.sh debian/pve-mods/usr/lib/pve-mods/apply-patches.sh
	install -Dm755 src/scripts/revert-patches.sh debian/pve-mods/usr/lib/pve-mods/revert-patches.sh
	# Configure tool
	install -Dm755 src/scripts/pve-mods-configure debian/pve-mods/usr/sbin/pve-mods-configure
	# Main config (conffile for user edits)
	install -Dm644 src/pve-mods.conf debian/pve-mods/etc/pve-mods/pve-mods.conf
	# Main config reference copy for upgrade key-diff (not a conffile)
	install -Dm644 src/pve-mods.conf debian/pve-mods/usr/share/pve-mods/pve-mods.conf.default
	# ── Dynamic section ────────────────────────────────────────────────────
	# `bash build/gen-rules.sh >> debian/rules` appends per-module install lines
	# here during CI, just before dpkg-buildpackage. Do not commit them.
