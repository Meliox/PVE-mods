#!/bin/bash
set -e

_revert_patches() {
    if [ -x /usr/lib/pve-mods/revert-patches.sh ]; then
        /usr/lib/pve-mods/revert-patches.sh 2>&1 || true
    fi
}

case "$1" in
    remove|deconfigure)
        # Revert patches before files are removed.
        _revert_patches
        ;;

esac

#DEBHELPER#
exit 0
