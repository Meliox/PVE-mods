#!/bin/bash
set -e

PATCHES_DIR="${PVE_MODs_PATCHES_DIR:-/usr/lib/pve-mods/patches}"
PATCH_ROOT="${PVE_MODs_ROOT:-/}"
MAIN_CONF="${PVE_MODs_MAIN_CONF:-/etc/pve-mods/pve-mods.conf}"
STATE_DIR="${PVE_MODs_STATE_DIR:-/var/lib/pve-mods}"
AUTO_DISABLED_FILE="$STATE_DIR/auto-disabled"
CHANGED=false

# Prints the modules set to 1 in the [modules] section of the main config.
list_enabled_modules() {
    [ -f "$MAIN_CONF" ] || return 0
    awk -F= '
        /^\[/ { in_sec = ($0 == "[modules]") }
        in_sec && /^[^#=]+=/ {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
            if ($2 == "1") print $1
        }
    ' "$MAIN_CONF"
}

# Sets <module>=0 in the [modules] section of the main config.
disable_module() {
    local mod="$1" tmp
    tmp="$(mktemp "${MAIN_CONF}.XXXXXX")" || return 1
    awk -v mod="$mod" '
        /^\[/ { in_sec = ($0 == "[modules]") }
        in_sec && $0 ~ "^[[:space:]]*" mod "[[:space:]]*=" { print mod "=0"; next }
        { print }
    ' "$MAIN_CONF" > "$tmp" \
        && chmod --reference="$MAIN_CONF" "$tmp" \
        && mv "$tmp" "$MAIN_CONF" \
        || { rm -f "$tmp"; return 1; }
}

# Prints the files a patch modifies, one per line.
patch_target_files() {
    awk '/^\+\+\+ / { sub(/^b\//, "", $2); print $2 }' "$1"
}

# Prints how to restore the given files (newline-separated, relative to the
# root): the owning package(s) when known, otherwise a generic instruction.
restore_hint() {
    local file pkg
    local -a pkgs=()
    if [ "$PATCH_ROOT" = "/" ] && command -v dpkg >/dev/null 2>&1; then
        while IFS= read -r file; do
            [ -n "$file" ] || continue
            pkg="$(dpkg -S -- "/$file" 2>/dev/null | awk '!/^diversion/ { sub(/: .*/, ""); print; exit }')"
            if [ -n "$pkg" ] && [[ " ${pkgs[*]} " != *" $pkg "* ]]; then
                pkgs+=("$pkg")
            fi
        done <<< "$1"
    fi
    if [ "${#pkgs[@]}" -gt 0 ]; then
        echo "[pve-mods] If they were modified outside pve-mods, restore the originals with: apt reinstall ${pkgs[*]}" >&2
    else
        echo "[pve-mods] If they were modified outside pve-mods, reinstall the packages that own these files ('dpkg -S <file>' shows which)." >&2
    fi
}

# Keep this diagnostic self-contained: preinst runs before package payload files
# are installed, so the helper script may not yet exist on upgrade.
report_patch_failure() {
    local patch_file="$1" output line current_file=""
    local target_path root start end hunk_number
    output="$(patch -R -p1 -F0 -f --dry-run --verbose -d "$PATCH_ROOT" < "$patch_file" 2>&1)" || true
    grep -E '^(checking file|Hunk #|[0-9]+ out of [0-9]+ hunks? FAILED)' <<< "$output" >&2 || true

    root="$PATCH_ROOT"
    [[ "$root" == /* ]] || root="$PWD/$root"
    while IFS= read -r line; do
        if [[ "$line" =~ ^checking\ file\ (.+)$ ]]; then
            current_file="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^Hunk\ \#([0-9]+)\ FAILED\ at\ ([0-9]+)\.?$ ]]; then
            hunk_number="${BASH_REMATCH[1]}"
            line="${BASH_REMATCH[2]}"
            target_path="${root%/}/$current_file"
            if [[ -f "$target_path" ]]; then
                start=$((line - 3))
                (( start < 1 )) && start=1
                end=$((line + 3))
                echo "Context at $target_path:$line (hunk #$hunk_number; 3 lines before/after):" >&2
                nl -ba "$target_path" | sed -n "${start},${end}p" >&2
            fi
        fi
    done <<< "$output"
}

case "$1" in
    upgrade)
        OLD_VERSION="${2:-unknown}"
        NEW_VERSION="${3:-unknown}"
        echo "[pve-mods] Uninstalling patches from version ${OLD_VERSION} before installing version ${NEW_VERSION}."
        # This new preinst runs before the old package files are replaced, so
        # its manifests and patches still describe exactly what is installed.
        # Only modules enabled in the config are handled; disabled modules are
        # never touched. Reverse only patches detected as currently applied.
        # A patch in an unknown state (e.g. its file was modified by another
        # tool) never aborts the upgrade: the module is disabled in the config
        # so the user can re-enable it after fixing the file.
        mapfile -t enabled_mods < <(list_enabled_modules)
        DISABLED_MODS=()
        if [ -d "$PATCHES_DIR" ]; then
            for mod in "${enabled_mods[@]}"; do
                mod_dir="$PATCHES_DIR/$mod/"
                [ -d "$mod_dir" ] || continue
                manifest="${mod_dir}patches.list"
                [ -f "$manifest" ] || continue
                unknown_files=""
                unknown_plain=""
                mapfile -t patches < <(
                    while IFS= read -r line || [ -n "$line" ]; do
                        line="${line%%#*}"
                        line="$(echo "$line" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
                        [ -z "$line" ] && continue
                        read -r patch_name _ <<< "$line"
                        echo "$patch_name"
                    done < "$manifest"
                )

                for (( i=${#patches[@]}-1; i>=0; i-- )); do
                    patch_file="${mod_dir}${patches[$i]}"
                    [ -f "$patch_file" ] || continue

                    if patch -R -p1 -F0 -d "$PATCH_ROOT" -f --dry-run -s < "$patch_file" >/dev/null 2>&1; then
                        if ! patch -R -p1 -F0 -d "$PATCH_ROOT" -f -s < "$patch_file"; then
                            echo "[pve-mods] ERROR: Failed to revert ${patches[$i]} during upgrade." >&2
                            exit 1
                        fi
                        echo "[pve-mods] Reverted ${patches[$i]} before package upgrade."
                        CHANGED=true
                    elif ! patch -p1 -F0 -d "$PATCH_ROOT" -f --dry-run -s < "$patch_file" >/dev/null 2>&1; then
                        echo "[pve-mods] WARNING: ${patches[$i]} of module '${mod}' is in an unknown state." >&2
                        report_patch_failure "$patch_file"
                        unknown_files="${unknown_files}$(patch_target_files "$patch_file" | sed 's/^/    /')"$'\n'
                        unknown_plain="${unknown_plain}$(patch_target_files "$patch_file")"$'\n'
                    fi
                done

                if [ -n "$unknown_files" ]; then
                    if disable_module "$mod"; then
                        DISABLED_MODS+=("$mod")
                        echo "[pve-mods] WARNING: Module '${mod}' was disabled automatically because these files do not match what its patches expect:" >&2
                    else
                        echo "[pve-mods] WARNING: Module '${mod}' could not be disabled in ${MAIN_CONF}; its patches may fail to apply. Files that do not match what its patches expect:" >&2
                    fi
                    printf '%s' "$unknown_files" >&2
                    echo "[pve-mods] They were either modified outside pve-mods, or changed by a Proxmox update that the installed patches are incompatible with." >&2
                    restore_hint "$unknown_plain"
                    echo "[pve-mods] Then re-enable the module with 'pve-mods-configure'." >&2
                fi
            done
        fi

        # Let postinst repeat the summary once the dpkg output has scrolled by.
        rm -f "$AUTO_DISABLED_FILE"
        if [ "${#DISABLED_MODS[@]}" -gt 0 ] && mkdir -p "$STATE_DIR" 2>/dev/null; then
            printf '%s\n' "${DISABLED_MODS[@]}" > "$AUTO_DISABLED_FILE" 2>/dev/null || true
        fi

        echo "[pve-mods] Uninstallation of patches from version ${OLD_VERSION} completed."

        if [ "$CHANGED" = "true" ] && command -v systemctl >/dev/null 2>&1; then
            if ! systemctl restart pveproxy; then
                echo "[pve-mods] WARNING: Could not restart pveproxy after reverting patches." >&2
            fi
        fi
        ;;
esac

#DEBHELPER#
exit 0
